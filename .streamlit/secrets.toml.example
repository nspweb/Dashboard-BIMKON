# Salin file ini jadi .streamlit/secrets.toml (untuk lokal) atau paste isinya
# ke menu "Secrets" di Streamlit Community Cloud saat deploy.
# JANGAN commit file secrets.toml yang sudah terisi ke Git manapun.

spreadsheet_id = "1bD2DxdwOKqE3hUOHy_9e_2M4h77O1MQjiW3x0hZKAt4"

# Opsional: isi di sini kalau mau API key permanen (kalau kosong, bisa diisi
# manual lewat sidebar tiap sesi). Ambil GRATIS (tanpa kartu kredit) di:
# https://console.groq.com/keys
groq_api_key = "gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Isi dari file JSON service account Google Cloud (lihat README.md untuk
# cara membuatnya). Salin persis strukturnya seperti di bawah.
[gcp_service_account]
type = "service_account"
project_id = "nama-project-anda"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nxxxxxxxxxxxx\n-----END PRIVATE KEY-----\n"
client_email = "nama-service-account@nama-project-anda.iam.gserviceaccount.com"
client_id = "xxxxxxxxxxxxxxxxxxxxx"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/nama-service-account%40nama-project-anda.iam.gserviceaccount.com"
